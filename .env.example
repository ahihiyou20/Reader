# Copy to .env.local. Leave the Firebase block empty to run in local demo mode
# (likes, saves, streak and comments are kept in this browser only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_SITE_URL=https://reader.pages.dev
NEXT_PUBLIC_REPO=ahihiyou20/Reader
NEXT_PUBLIC_REPO_BRANCH=main
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
