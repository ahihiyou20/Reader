rules_version = '2';
// Reader — Firestore Security Rules (docs/06 §3.5). All writes come from clients (Spark plan, no
// Cloud Functions), so the rules carry the business logic: counters move by ±1 and only together
// with the matching like/save document, the streak can only stay, grow by one or restart at one.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // A guest who links Google keeps the same uid; the linked identity shows up in the token.
    function isGoogle() { return signedIn() && request.auth.token.firebase.identities.keys().hasAny(['google.com']); }
    function isMod() { return signedIn() && exists(/databases/$(db)/documents/moderators/$(request.auth.uid)); }
    function myDoc(sub, id) { return /databases/$(db)/documents/users/$(request.auth.uid)/$(sub)/$(id); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isString(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function delta(field, d) {
      return changed().hasOnly([field])
        && request.resource.data[field] == resource.data.get(field, 0) + d
        && request.resource.data[field] >= 0;
    }
    // A counter moves only in the write that creates (+1) or deletes (-1) the reader's own like/save,
    // so the same like cannot be counted twice. exists() costs one document read and a batch may use 20
    // (existsAfter on a document written in the same batch is free), so clients send at most 9 pairs.
    function added(sub, id) { return !exists(myDoc(sub, id)) && existsAfter(myDoc(sub, id)); }
    function removed(sub, id) { return exists(myDoc(sub, id)) && !existsAfter(myDoc(sub, id)); }
    // The other half: a like or save is deleted only in the write that takes its count back down, so
    // like, delete the like alone, like again cannot raise the count. A counter that is gone or already
    // at zero has nothing to take back.
    function counted(c, field) {
      return !exists(c) || get(c).data.get(field, 0) == 0
        || (existsAfter(c) && getAfter(c).data.get(field, 0) == get(c).data.get(field, 0) - 1);
    }
    function undone(field, slug) { return counted(/databases/$(db)/documents/counters/$(slug), field); }
    // The comment counter counts visible comments. Each write that moves it names the comment in
    // `lastComment`: +1 when that comment is created in the same write, -1 when a visible one is
    // deleted or hidden in it.
    function commentDoc(slug, id) { return /databases/$(db)/documents/comments/$(slug)/items/$(id); }
    function commentCreated(slug, id) { return !exists(commentDoc(slug, id)) && existsAfter(commentDoc(slug, id)); }
    function commentRemoved(slug, id) {
      return exists(commentDoc(slug, id)) && get(commentDoc(slug, id)).data.status == 'visible'
        && (!existsAfter(commentDoc(slug, id)) || getAfter(commentDoc(slug, id)).data.status == 'hidden');
    }
    function commentDelta(slug, d) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'lastComment'])
        && request.resource.data.comments == resource.data.get('comments', 0) + d
        && request.resource.data.comments >= 0
        && request.resource.data.lastComment is string
        && (d == 1 ? commentCreated(slug, request.resource.data.lastComment) : commentRemoved(slug, request.resource.data.lastComment));
    }

    // ---------- Users ----------
    function validStreak(s) {
      return s is map && s.keys().hasOnly(['current', 'longest', 'lastReadDate'])
        && s.current is int && s.current >= 0 && s.longest is int && s.longest >= s.current
        && (s.lastReadDate == null || (s.lastReadDate is string && s.lastReadDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }
    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'photoURL', 'isAnonymous', 'lang', 'timezone', 'streak', 'stats', 'createdAt', 'lastActiveAt', 'lastCommentAt', 'lastPostAt'])
        && (d.displayName == null || isString(d.displayName, 1, 60))
        && (d.photoURL == null || isString(d.photoURL, 1, 1000))
        && d.isAnonymous == !isGoogle()
        && d.lang in ['en', 'vi', 'fr', 'de', 'es']
        && isString(d.timezone, 1, 64)
        && validStreak(d.streak)
        && d.stats is map && d.stats.keys().hasOnly(['articlesRead']) && d.stats.articlesRead is int
        && d.stats.articlesRead >= 0 && d.stats.articlesRead <= 100000;
    }

    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create: if isMe(uid) && validProfile(request.resource.data) && !('lastCommentAt' in request.resource.data) && !('lastPostAt' in request.resource.data)
        && request.resource.data.streak.current == 0 && request.resource.data.stats.articlesRead == 0
        && request.resource.data.createdAt == request.time;
      allow update: if isMe(uid) && validProfile(request.resource.data)
        && changed().hasOnly(['displayName', 'photoURL', 'isAnonymous', 'lang', 'timezone', 'streak', 'stats', 'lastActiveAt', 'lastCommentAt', 'lastPostAt'])
        && (!changed().hasAny(['lastCommentAt']) || request.resource.data.lastCommentAt == request.time)
        && (!changed().hasAny(['lastPostAt']) || request.resource.data.lastPostAt == request.time)
        && (request.resource.data.streak.current == resource.data.streak.current
            || request.resource.data.streak.current == resource.data.streak.current + 1
            || request.resource.data.streak.current == 1);

      match /likes/{slug} {
        allow read: if isMe(uid);
        allow delete: if isMe(uid) && undone('likes', slug);
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['slug', 'createdAt']) && request.resource.data.slug == slug;
      }
      match /saves/{slug} {
        allow read: if isMe(uid);
        allow delete: if isMe(uid) && undone('saves', slug);
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['slug', 'createdAt']) && request.resource.data.slug == slug;
      }
      // One per article the reader has shared: the share counter counts readers, not taps.
      match /shares/{slug} {
        allow read: if isMe(uid);
        // Deleted only with one off the counter, so delete-and-share-again cannot raise it.
        allow delete: if isMe(uid) && undone('shares', slug);
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['slug', 'createdAt']) && request.resource.data.slug == slug;
      }
      match /progress/{slug} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['lastSection', 'completed', 'completedAt', 'applyDone', 'updatedAt'])
          && (!('lastSection' in request.resource.data) || (request.resource.data.lastSection is int && request.resource.data.lastSection >= 0 && request.resource.data.lastSection < 50))
          && (!('applyDone' in request.resource.data) || (request.resource.data.applyDone is list && request.resource.data.applyDone.size() <= 3));
      }
      match /readDays/{day} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['slugs']) && request.resource.data.slugs is list && request.resource.data.slugs.size() <= 200;
      }
      // Reading data kept with the account: favourite topics, per-topic signals, history, collections
      // and reading settings (stores/reading.ts), as one document.
      match /reading/{id} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && id == 'state'
          && request.resource.data.keys().hasOnly(['topics', 'signals', 'history', 'collections', 'settings', 'freeze', 'updatedAt'])
          && request.resource.data.topics is list && request.resource.data.topics.size() <= 50
          && request.resource.data.signals is map && request.resource.data.signals.size() <= 50
          && request.resource.data.history is list && request.resource.data.history.size() <= 300
          && request.resource.data.collections is list && request.resource.data.collections.size() <= 100
          && request.resource.data.settings is map
          && (!('freeze' in request.resource.data) || (request.resource.data.freeze is map
            && request.resource.data.freeze.count is int && request.resource.data.freeze.count >= 0 && request.resource.data.freeze.count <= 2
            && request.resource.data.freeze.covered is list && request.resource.data.freeze.covered.size() <= 60));
      }
      match /commentLikes/{key} {
        allow read: if isMe(uid);
        // A hidden comment's count is not shown (and the reader may not read it to take one off).
        allow delete: if isMe(uid) && (counted(commentDoc(resource.data.slug, resource.data.id), 'likeCount')
          || get(commentDoc(resource.data.slug, resource.data.id)).data.status != 'visible');
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['slug', 'id', 'createdAt'])
          && key == request.resource.data.slug + '__' + request.resource.data.id;
      }
    }

    // ---------- Counters ----------
    match /counters/{slug} {
      allow read: if true;
      allow create: if signedIn() && (
           (request.resource.data.keys().hasOnly(['likes']) && request.resource.data.likes == 1 && added('likes', slug))
        || (request.resource.data.keys().hasOnly(['saves']) && request.resource.data.saves == 1 && added('saves', slug))
        || (request.resource.data.keys().hasOnly(['shares']) && request.resource.data.shares == 1 && added('shares', slug))
        || (request.resource.data.keys().hasOnly(['comments', 'lastComment']) && request.resource.data.comments == 1
            && request.resource.data.lastComment is string && commentCreated(slug, request.resource.data.lastComment)));
      allow update: if signedIn() && (
           (delta('likes', 1) && added('likes', slug))
        || (delta('likes', -1) && removed('likes', slug))
        || (delta('saves', 1) && added('saves', slug))
        || (delta('saves', -1) && removed('saves', slug))
        || (delta('shares', 1) && added('shares', slug))
        || (delta('shares', -1) && removed('shares', slug))
        || commentDelta(slug, 1)
        || commentDelta(slug, -1));
    }

    // ---------- Comments ----------
    // One comment per 15 s per reader: the write that creates a comment stamps the profile's
    // lastCommentAt, and the stamp before it must be older. Keeps a script from flooding a thread or
    // spending the project's daily write quota.
    function me() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function paced() { return stamped('lastCommentAt', 15); }
    // The write stamps users/{uid}.<field> with its own time, and the stamp before it is `secs` old.
    function stamped(field, secs) {
      return existsAfter(me()) && getAfter(me()).data.get(field, null) == request.time
        && (!exists(me()) || get(me()).data.get(field, null) == null
          || get(me()).data[field] < request.time - duration.value(secs, 's'));
    }
    match /comments/{slug}/items/{id} {
      allow read: if resource.data.status == 'visible' || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'text', 'lang', 'status', 'likeCount', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isString(request.resource.data.displayName, 1, 60)
        // Everyone who reads the thread loads this picture: a Google avatar only, never a server of the
        // commenter's choosing that would see each reader's address.
        && (request.resource.data.photoURL == null || (isString(request.resource.data.photoURL, 1, 1000)
          && request.resource.data.photoURL.matches('^https://lh[0-9]+[.]googleusercontent[.]com/.*')))
        && isString(request.resource.data.text, 1, 500)
        && request.resource.data.lang in ['en', 'vi', 'fr', 'de', 'es']
        && request.resource.data.status == 'visible'
        && request.resource.data.likeCount == 0
        && request.resource.data.createdAt == request.time
        && paced();
      allow update: if (isMod() && changed().hasOnly(['status']) && request.resource.data.status in ['visible', 'hidden'])
        || (signedIn() && resource.data.uid == request.auth.uid && changed().hasOnly(['displayName', 'photoURL'])
            && request.resource.data.displayName == 'Deleted user' && request.resource.data.photoURL == null)
        || (signedIn() && delta('likeCount', 1) && added('commentLikes', slug + '__' + id))
        || (signedIn() && delta('likeCount', -1) && removed('commentLikes', slug + '__' + id));
      // A visible comment goes with one off the counter, in the same write.
      allow delete: if ((signedIn() && resource.data.uid == request.auth.uid) || isMod())
        && (resource.data.status != 'visible' || counted(/databases/$(db)/documents/counters/$(slug), 'comments'));
    }
    // Your own comments across all articles (export and account deletion).
    match /{path=**}/items/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Posts sent with the + button ----------
    match /submissions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'title', 'hook', 'sections', 'references', 'coverUrl', 'lang', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && isString(request.resource.data.displayName, 1, 60)
        && isString(request.resource.data.title, 1, 120)
        && isString(request.resource.data.hook, 1, 1200)
        && request.resource.data.sections is list && request.resource.data.sections.size() >= 1 && request.resource.data.sections.size() <= 10
        && request.resource.data.references is list && request.resource.data.references.size() <= 20
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 500
        && request.resource.data.lang in ['en', 'vi', 'fr', 'de', 'es']
        && request.resource.data.createdAt == request.time
        // One post per 10 minutes per reader, like comments (stamped on the profile in the same write).
        && stamped('lastPostAt', 600);
    }

    match /moderators/{uid} {
      allow read: if isMe(uid);
    }
  }
}
